# Konfigurasi & rahasia — jangan pernah di-commit
.env
.env.local
.env.*.local

# Data runtime: dokumen user, bukti transfer, plugin, cache, log.
# Auto-deploy menimpa direktori target, jadi folder ini WAJIB di luar Git
# supaya file yang diupload user tidak tertimpa/hilang saat deploy.
storage/*
!storage/*/
storage/*/*
!storage/**/.gitkeep

# Frontend: dependency dan hasil build antara.
# Hasil build yang dipakai server disalin ke root (index.html + assets/) lewat
# "npm run deploy" dan ikut di-commit, karena server tidak menjalankan build.
frontend/node_modules/
frontend/dist/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
