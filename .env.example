# ==========================================
# ENVIRONMENT CONFIGURATION — TEMPLATE
# Salin ke .env lalu isi nilainya.
# .env TIDAK boleh di-commit (lihat .gitignore).
# ==========================================

# --- LOCAL DEVELOPMENT (XAMPP) ---
# APP_ENV=development
# APP_URL=http://localhost/apeiron/PORTAL/public
# LICENSE_SERVER_URL=http://localhost/SERVER/api
# CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://127.0.0.1,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- PRODUCTION (ENABLE WHEN UPLOADING TO HOSTING) ---
APP_ENV=production
APP_URL=https://contoh-domain.web.id
LICENSE_SERVER_URL=https://contoh-server.web.id/api

# --- SECURITY ---
# Kunci API ke license server (rahasia)
LICENSE_SERVER_API_KEY=
# Minimal 32 karakter acak (rahasia)
APP_SECRET_KEY=

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# --- LOCAL DATABASE (XAMPP) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=portal_apeiron
# DB_USER=root
# DB_PASS=

# --- PRODUCTION DATABASE ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- CORS (Production) ---
CORS_ALLOWED_ORIGINS=https://contoh-domain.web.id,https://contoh-server.web.id

# ==========================================
# MAIL CONFIGURATION (OPTIONAL)
# ==========================================
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Portal Apeiron
